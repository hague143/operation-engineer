# Copy to .env and replace this placeholder with a random local secret.
DJANGO_SECRET_KEY=replace-with-a-random-secret-generated-locally
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Demo passwords are optional, local-only, and must be distinct (minimum 12 characters).
# Alternatively use: python manage.py changepassword demo.inspector
DEMO_INSPECTOR_PASSWORD=
DEMO_REVIEWER_PASSWORD=
