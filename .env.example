# Copy to .env and replace this placeholder with a random local secret.
DJANGO_SECRET_KEY=replace-with-a-random-secret-generated-locally
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Demo passwords are optional, local-only, and must be distinct (minimum 12 characters).
# Alternatively use: python manage.py changepassword demo.inspector
DEMO_INSPECTOR_PASSWORD=
DEMO_REVIEWER_PASSWORD=

# Vercel ONLY: set these in Project Settings > Environment Variables,
# for Preview and Production. Never upload .env or commit real secret values.
# ASSETINSPECT_VERCEL_DEMO=1
# DJANGO_SECRET_KEY=<random-secret-at-least-50-characters>
# DEMO_INSPECTOR_PASSWORD=<distinct-password-at-least-12-characters>
# DEMO_REVIEWER_PASSWORD=<different-password-at-least-12-characters>
# DJANGO_DEBUG=False
# Optional custom domain (Vercel's exact system-provided hosts are automatic):
# DJANGO_ALLOWED_HOSTS=your-custom-domain.example
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-custom-domain.example
